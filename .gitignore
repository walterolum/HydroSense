# ─────────────────────────────────────────────────────────
# HYDROSENSE — Enterprise .gitignore
# FastAPI + Python + React + AI Services
# ─────────────────────────────────────────────────────────

# ===== PYTHON =====
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
*.whl
*.manifest
*.spec

# ===== VIRTUAL ENVIRONMENTS =====
.venv/
venv/
env/
.env/
.venv_*/
ENV/

# ===== FASTAPI / SERVER =====
*.pid
*.db
*.db-shm
*.db-wal
*.sqlite3
alembic/versions/*.py
!alembic/versions/.gitkeep
uploaded_files/
media/

# ===== REACT / NODE =====
node_modules/
.next/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm/
*.tsbuildinfo
.eslintcache
.cache/
.turbo/

# ===== AI SERVICE =====
models/
model_cache/
*.h5
*.pth
*.pt
*.onnx
*.pb
*.tflite
*.mlmodel
mlruns/
wandb/
lightning_logs/
ray_results/
tensorboard_logs/

# ===== GIT =====
# Keep only generated/transient git files out
*.orig
*.patch
*.rej
*.swp
*.swo
*~

# ===== IDE & EDITORS =====
.vscode/settings.json
.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.vscode-test/
.history/

# ===== OS GENERATED =====
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
*.lnk
*.dll

# ===== SECURITY =====
.env
.env.*
!.env.example
!.env.template
*.key
*.pem
*.crt
*.cert
credentials.json
service-account.json
*.secret

# ===== LOGS =====
*.log
logs/
log/

# ===== DATA / UPLOADS =====
uploads/
temp/
tmp/
data/raw/
data/temp/

# ===== TESTING =====
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
coverage/

# ===== DOCKER =====
.docker/
docker-compose.override.yml

# ===== DEPENDENCY LAYER (lock artifacts) =====
# Comment out the line below if you commit lock files
package-lock.json
yarn.lock
pnpm-lock.yaml
Pipfile.lock
poetry.lock

# ===== SCRATCH / TEST SCRIPTS =====
server/scratch/

# ===== PROFESSIONAL DEV EXCLUSIONS =====
.devcontainer/ (keep if needed)
