# ═══════════════════════════════════════════════════════════════════════════
# HydroSense AI Service — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════

# ── PostgreSQL Connection ────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=hydrosense
PG_USER=hydrosense
PG_PASSWORD=your_strong_password_here
PG_POOL_MIN=2
PG_POOL_MAX=10

# ── Service Configuration ────────────────────────────────────────────────
PORT=8000
GEMINI_API_KEY=your_gemini_api_key_for_ai_service
GEMINI_MODEL=gemini-2.5-pro-preview-05-20
