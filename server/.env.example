# ═══════════════════════════════════════════════════════
# HydroSense Server — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════

# ── Core ─────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_min_32_chars
PORT=5000
NODE_ENV=production
DB_PATH=./watermonitor.db

# ── SMS: Africa's Talking (Primary — Uganda/Africa) ──
# Sign up at https://africastalking.com
# Use username=sandbox + any key for testing
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=your_at_username          # 'sandbox' for testing
AT_SENDER_ID=HydroSense              # Optional sender name (approved short code)

# ── SMS: Twilio (International Fallback) ─────────────
# Sign up at https://twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ── Email: Brevo (Primary) ───────────────────────────
# Sign up at https://brevo.com (free tier: 300 emails/day)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email: SendGrid (Secondary Fallback) ─────────────
# Sign up at https://sendgrid.com (free tier: 100 emails/day)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email: Gmail SMTP (Final Fallback) ───────────────
# Enable 2FA on your Gmail, then create an App Password:
# https://myaccount.google.com/apppasswords
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM_NAME=HydroSense Platform
EMAIL_FROM_ADDRESS=noreply@hydrosense.ug

# ── Gemini AI ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
