# ═══════════════════════════════════════════════════════════════════════════
# HydroSense Server — Environment Variables
# Copy this to .env and fill in your values. NEVER commit .env.
# ═══════════════════════════════════════════════════════════════════════════

# ── PostgreSQL Connection ────────────────────────────────────────────────
# Running locally: PG_HOST=localhost, PG_USER=hydrosense, PG_PASSWORD=hydrosense
# Running via Docker: PG_HOST=postgres
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=hydrosense
PG_USER=hydrosense
PG_PASSWORD=your_strong_password_here
PG_POOL_MAX=20
PG_IDLE_TIMEOUT=30000
PG_CONNECTION_TIMEOUT=5000

# ── PostgreSQL SSL (set to 1 for Neon/RDS, omit for local) ───────────────
# PG_SSL=1

# ── Core ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_min_32_chars_random
AI_PORT=8000

# ── Google OAuth (for social login on the Login page) ────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here

# ── Gemini AI ────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ── SMS: Africa's Talking (Primary) ──────────────────────────────────────
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=HydroSense

# ── SMS: Twilio (International Fallback) ─────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ── Email: Brevo (Primary) ───────────────────────────────────────────────
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email: SendGrid (Secondary) ──────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Email: Gmail SMTP (Final Fallback) ───────────────────────────────────
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM_NAME=HydroSense Platform
EMAIL_FROM_ADDRESS=noreply@hydrosense.ug

# ── Admin Bootstrap ──────────────────────────────────────────────────────
ADMIN_EMAIL=walter.olum@hydrosense.ug
ADMIN_PASSWORD=your_strong_admin_password
ADMIN_NAME=Walter Olum
